
name: West Palm Beach Transit Reel

on:
  workflow_dispatch:

jobs:
  render:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4

      - uses: astral-sh/setup-uv@v6

      - name: Render morning rush
        run: |
         uv run transit-reels render recipes/palm-beach-county.toml

      - name: Upload video
        uses: actions/upload-artifact@v4
        with:
          name: west-palm-preview
          path: work/west-palm/*.mp4
          if-no-files-found: error
